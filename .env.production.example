# no trailing slash. If frontend and backend are on the same domain behind a reverse proxy,
# this can be a relative path like /api instead of a full URL — see README-DEPLOY.md.
VITE_API_BASE=https://TODO-your-backend-url-here.com

# TODO: same Google OAuth Client ID used in the backend's .env
VITE_GOOGLE_CLIENT_ID=
