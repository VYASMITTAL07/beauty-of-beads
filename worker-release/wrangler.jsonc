{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "beauty-of-beads-api",
  "main": "./index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beauty-of-beads-media"
    }
  ]
}
