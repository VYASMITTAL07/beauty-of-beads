# Fingerprinted Vite assets can be cached long-term because every build gets
# new hashed filenames.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep HTML fresh so it always points to the current hashed bundles.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/admin
  Cache-Control: public, max-age=0, must-revalidate
/admin.html
  Cache-Control: public, max-age=0, must-revalidate
